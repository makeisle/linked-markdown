{
  "name": "@lmd/editor-shell",
  "version": "0.1.0",
  "description": "The `.lmd` editing screen (@-autocomplete linking, import sidebar) with an injectable workspace.",
  "license": "Apache-2.0",
  "author": "makeisle",
  "homepage": "https://github.com/makeisle/linked-markdown#readme",
  "repository": { "type": "git", "url": "git+https://github.com/makeisle/linked-markdown.git", "directory": "packages/editor-shell" },
  "bugs": "https://github.com/makeisle/linked-markdown/issues",
  "keywords": ["linked-markdown", "lmd", "editor"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
